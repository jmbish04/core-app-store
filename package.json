{
  "name": "core-app-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace=frontend & npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspaces",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./prisma/schema.prisma --name",
    "prisma:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "deploy": "npm run build && cd src && wrangler deploy",
    "deploy:dry-run": "npm run build && cd src && wrangler deploy --dry-run",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "workspaces": [
    "src",
    "frontend",
    "shared"
  ],
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@prisma/adapter-d1": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.54.0"
  }
}
